{
  "manifest_version": 3,
  "name": "FairFlow AI",
  "version": "0.4.0",
  "description": "Automatically monitor checkout changes and explain risky price or consent patterns.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Audit this checkout with FairFlow"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["auto-monitor.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
