{
  "name": "fairflow-extension",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:capture": "tsc -p tsconfig.capture-test.json && node --test tests/capture.test.mjs",
    "check:privacy": "python validate_privacy.py",
    "check:accessibility": "python validate_accessibility.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "happy-dom": "^20.14.5"
  }
}
